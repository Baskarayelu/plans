# ─────────────────────────────────────────────────────────────────────────────
# Plans relayer configuration. Copy to .env (never commit .env).
# Private keys are read from the environment only and are never logged.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP
PORT=8080                       # Railway sets PORT automatically
HOST=0.0.0.0
LOG_LEVEL=info                  # debug | info | warn | error

# Chain: 143 = Monad mainnet, 10143 = Monad testnet, 31337 = local anvil
CHAIN_ID=10143
# Comma-separated HTTP RPCs, used with fallback. Defaults by chain:
#   143   → https://rpc.monad.xyz,https://rpc1.monad.xyz,https://rpc2.monad.xyz,https://rpc3.monad.xyz
#   10143 → https://testnet-rpc.monad.xyz
RPC_URL=
# Websocket RPC for the `logs` subscription. Empty = chain default (mainnet wss://rpc.monad.xyz;
# testnet has none, so polling only). Set to "none" to disable.
WS_URL=

# Contracts (from the contracts deployment). KeyRegistry, ClaimEscrow, AUSD and FxReference are read
# from the factory when left empty (FxReference is read-only here: GET /v1/fx/round).
# AUSD defaults: mainnet 0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a, testnet 0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC.
FACTORY_ADDRESS=
PLANS_SEND_ADDRESS=
KEY_REGISTRY_ADDRESS=
CLAIM_ESCROW_ADDRESS=
FX_REFERENCE_ADDRESS=
AUSD_ADDRESS=

# Relayer hot keys: comma-separated 0x private keys, one nonce lane each (3 recommended).
# Monad caps each sender's gas spend over 3 blocks (reserve-balance rule), so spread load over keys.
# Fund each with MON. Never EIP-7702-delegate these keys. Lane 0 also signs FX quotes and holds faucet AUSD.
RELAYER_KEYS=

# Local state (SQLite). On Railway mount a volume here.
DATA_DIR=./data

# Event listener
LISTENER_ENABLED=true
START_BLOCK=                    # factory deploy block; empty = start at the current head (first run only)
LOG_CHUNK_BLOCKS=100            # eth_getLogs range per request (public RPC limit is 100)
POLL_INTERVAL_MS=2000           # gap-filling poll; the websocket gives real-time delivery

# Gas policy: Monad charges gas on the LIMIT, so limit = estimate * (1 + bps/10000) + fixed, capped per action.
GAS_MARGIN_BPS=1000
GAS_MARGIN_FIXED=10000
GAS_CAPS=                       # JSON overrides, e.g. {"settle":6000000,"propose":1200000}
PRIORITY_FEE_GWEI=2
MAX_FEE_GWEI=1000               # hard ceiling on maxFeePerGas (base fee floor is 100 gwei)
LANE_MIN_BALANCE_WEI=500000000000000000   # lanes below 0.5 MON are skipped and flagged in /v1/health

# HTTP limits
BODY_LIMIT_BYTES=65536
CORS_ORIGINS=https://plans.0xo.in          # comma-separated
TRUST_PROXY=true                # use X-Forwarded-For for client IPs (true behind Railway)
RATE_LIMIT_IP_PER_MIN=120       # all POSTs, per client IP
RATE_LIMIT_ADDRESS_PER_MIN=30   # /v1/relay, per signing account
CREATE_POT_PER_IP_PER_DAY=30

# FX reference (ECB via frankfurter.app), cached; responses are EIP-191 signed
FX_URL=https://api.frankfurter.app/latest
FX_CACHE_MS=600000
FX_SIGNER_KEY=                  # optional; defaults to the first RELAYER_KEYS key

# Testnet faucet (always off on mainnet). Defaults on for CHAIN_ID=10143.
FAUCET_ENABLED=
FAUCET_ADDRESS=                 # default testnet faucet 0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C
FAUCET_AMOUNT=25000000          # AUSD base units (6 decimals) → 25 AUSD
FAUCET_PER_ADDRESS_PER_DAY=1
FAUCET_PER_IP_PER_DAY=40        # a venue's Wi-Fi puts a whole group behind one address
FAUCET_TOTAL_PER_DAY=400        # all accounts together, per UTC day

# Push notifications (Expo)
PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=              # optional, if Expo enhanced push security is on

# Demo members (Ben GB, Asha IN, Maya US). Ordinary members acting through the relay path.
DEMO_ENABLED=false
DEMO_KEY_BEN=
DEMO_KEY_ASHA=
DEMO_KEY_MAYA=
DEMO_APPROVE_CAP=1000000        # auto-approve spends up to $1 (base units)
DEMO_VOTE_DELAY_MIN_MS=3000
DEMO_VOTE_DELAY_MAX_MS=8000
DEMO_STEP_DELAY_MS=1500         # pause between scripted "Try a settle-up" steps
DEMO_DEPOSIT=100000             # each demo member's contribution in a settle-up run ($0.10)
DEMO_MAX_OUTLAY=300000          # cap on total demo deposits per run ($0.30)
DEMO_PLAN_MINUTES=15
DEMO_PER_JUDGE_PER_DAY=3
DEMO_PER_IP_PER_DAY=40
DEMO_TICK_MS=1000

# Encrypted receipt-photo blobs (ciphertext only; content-addressed by sha256)
BLOB_DIR=                       # default <DATA_DIR>/blobs (sharded aa/bb/<sha256>); keep on the /data volume
BLOB_MAX_BYTES=2097152          # 2 MB per blob, measured on the decoded bytes
BLOB_DISK_CAP_BYTES=2147483648  # 2 GB total; uploads get 507 STORAGE_FULL beyond this
BLOB_PUT_PER_IP_PER_HOUR=60
SLOT_PUT_PER_IP_PER_HOUR=60    # keyed slots (browser linking) live in <BLOB_DIR>/slots, share the disk cap

# Long-stop: settle plans nobody settled, 30 days after endTime + reviewWindow
LONGSTOP_ENABLED=true
LONGSTOP_INTERVAL_MS=3600000
LONGSTOP_GRACE_DAYS=30
