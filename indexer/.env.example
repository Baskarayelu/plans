# Envio HyperIndex — Plans indexer.
# Copy to .env for local runs; set the same keys in Envio Cloud → Indexer → Environment variables.
# Hosted env vars must use the ENVIO_ prefix.

# HyperSync API token (https://envio.dev/app/api-tokens). Needed for local runs.
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# ── Monad mainnet (chain 143) ── TODO: uncomment and fill after deployment (unset = inert placeholder)
ENVIO_MAINNET_START_BLOCK=0
# ENVIO_MAINNET_FACTORY_ADDRESS=0x...
# ENVIO_MAINNET_KEY_REGISTRY_ADDRESS=0x...
# ENVIO_MAINNET_CLAIM_ESCROW_ADDRESS=0x...
# ENVIO_MAINNET_SEND_ADDRESS=0x...
# ENVIO_MAINNET_FX_REFERENCE_ADDRESS=0x...

# ── Monad testnet (chain 10143) ── TODO: uncomment and fill after deployment (unset = inert placeholder)
ENVIO_TESTNET_START_BLOCK=0
# ENVIO_TESTNET_FACTORY_ADDRESS=0x...
# ENVIO_TESTNET_KEY_REGISTRY_ADDRESS=0x...
# ENVIO_TESTNET_CLAIM_ESCROW_ADDRESS=0x...
# ENVIO_TESTNET_SEND_ADDRESS=0x...
# ENVIO_TESTNET_FX_REFERENCE_ADDRESS=0x...

# Optional: path to a different internal-accounts list (default: ./internal-accounts.json)
# ENVIO_INTERNAL_ACCOUNTS_FILE=internal-accounts.json
