{
  "name": "plans-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-copy.mjs && jest",
    "lint:copy": "node scripts/check-copy.mjs",
    "prebuild:testnet": "APP_NETWORK=testnet expo prebuild --platform android --clean",
    "prebuild:mainnet": "APP_NETWORK=mainnet expo prebuild --platform android --clean",
    "web": "PLANS_WEB=1 expo start --web",
    "build:web": "bash scripts/build-web.sh testnet",
    "apk:testnet:debug": "bash scripts/build-apk.sh testnet debug",
    "apk:testnet:release": "bash scripts/build-apk.sh testnet release",
    "apk:mainnet:release": "bash scripts/build-apk.sh mainnet release"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-brightness": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-modules-core": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "html2canvas": "^1.4.1",
    "jsqr": "^1.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-passkey": "3.6.2",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.3",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@category-labs/mera": {
      "react-native-passkey": "$react-native-passkey"
    }
  }
}
