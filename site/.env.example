# Envio HyperIndex GraphQL endpoint (Hasura), e.g. https://indexer.hyperindex.xyz/<id>/v1/graphql
# Unset or unreachable: /stats and the landing counters show "Counting starts at launch". Never faked.
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=
# Chain whose traction is shown: 143 = Monad mainnet (default), 10143 = testnet
NEXT_PUBLIC_CHAIN_ID=143
